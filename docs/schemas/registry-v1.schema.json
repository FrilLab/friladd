{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrilAdd Registry Manifest v1",
  "description": "FrilAdd also enforces UTF-8 byte limits, unique item names, and portable target ownership within each item. FrilAdd checks that required text contains a non-whitespace character.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9._-]*[A-Za-z0-9_-]/)*[A-Za-z0-9._-]*[A-Za-z0-9_-](?![\\s\\S])",
      "not": {
        "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[./]|(?![\\s\\S]))"
      }
    },
    "targetPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:\\.(?:[Gg][Ii][Tt]|[Hh][Gg]|[Ss][Vv][Nn]|[Jj][Jj]|[Ff][Rr][Ii][Ll][Aa][Dd][Dd](?:\\.[Jj][Ss][Oo][Nn])?)|[Ff][Rr][Ii][Ll][Aa][Dd][Dd]\\.[Ll][Oo][Cc][Kk]\\.[Jj][Ss][Oo][Nn])(?:/|(?![\\s\\S]))|(?:^|/)\\.[Ff][Rr][Ii][Ll][Aa][Dd][Dd]-"
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "name",
        "description",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "source",
        "target",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "target": {
          "$ref": "#/$defs/targetPath"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[A-Fa-f0-9]{64}(?![\\s\\S])"
        }
      }
    }
  }
}
