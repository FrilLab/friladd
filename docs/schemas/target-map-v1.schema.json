{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrilAdd Target Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "defaultRoot": {
      "anyOf": [
        {
          "$ref": "#/$defs/targetPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "kindRoots": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "component",
          "asset",
          "material",
          "texture",
          "image",
          "environment",
          "animation",
          "composition",
          "other"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/targetPath"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9._-]*[A-Za-z0-9_-]/)*[A-Za-z0-9._-]*[A-Za-z0-9_-](?![\\s\\S])",
      "not": {
        "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[./]|(?![\\s\\S]))"
      }
    },
    "targetPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:\\.(?:[Gg][Ii][Tt]|[Hh][Gg]|[Ss][Vv][Nn]|[Jj][Jj]|[Ff][Rr][Ii][Ll][Aa][Dd][Dd](?:\\.[Jj][Ss][Oo][Nn])?)|[Ff][Rr][Ii][Ll][Aa][Dd][Dd]\\.[Ll][Oo][Cc][Kk]\\.[Jj][Ss][Oo][Nn])(?:/|(?![\\s\\S]))|(?:^|/)\\.[Ff][Rr][Ii][Ll][Aa][Dd][Dd]-"
          }
        }
      ]
    }
  }
}
