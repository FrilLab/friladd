{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrilAdd machine output v1",
  "type": "object",
  "required": ["schemaVersion", "command", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "enum": ["add", "installed", "status", "update", "remove", "restore", "list", "search", "info", "doctor", "registry list", "registry verify"] },
    "data": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "registry list" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["registries"],
            "properties": {
              "registries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["alias", "source", "scope", "default"],
                  "properties": {
                    "alias": { "type": "string", "minLength": 1 },
                    "source": { "type": "string", "minLength": 1 },
                    "scope": { "enum": ["project", "global"] },
                    "default": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "registry verify" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["registry", "manifestSha256", "itemCount", "fileCount"],
            "properties": {
              "registry": { "type": "string", "minLength": 1 },
              "manifestSha256": { "$ref": "#/$defs/digest" },
              "itemCount": { "type": "integer", "minimum": 0 },
              "fileCount": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "doctor" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["project", "version", "platform", "defaultRegistry", "packageManagers", "managed", "summary", "checks", "transactionPending"],
            "properties": {
              "project": { "type": ["string", "null"] },
              "version": { "type": "string" },
              "platform": { "type": "object", "required": ["os", "arch"], "properties": { "os": { "type": "string" }, "arch": { "type": "string" } }, "additionalProperties": false },
              "defaultRegistry": { "type": ["string", "null"] },
              "packageManagers": { "type": "array", "items": { "enum": ["npm", "pnpm", "yarn", "bun"] } },
              "managed": { "type": "object", "required": ["itemCount", "fileCount", "fileStates"], "properties": { "itemCount": { "type": "integer", "minimum": 0 }, "fileCount": { "type": "integer", "minimum": 0 }, "fileStates": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } }, "additionalProperties": false },
              "summary": {
                "type": "object",
                "required": ["ok", "warn", "fail", "skip"],
                "properties": {
                  "ok": { "type": "integer", "minimum": 0 },
                  "warn": { "type": "integer", "minimum": 0 },
                  "fail": { "type": "integer", "minimum": 0 },
                  "skip": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "checks": { "type": "array", "items": { "$ref": "#/$defs/doctorCheck" } },
              "transactionPending": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "enum": ["list", "search"] } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["items"],
            "properties": {
              "registry": { "type": "string" },
              "query": { "type": "string" },
              "items": { "type": "array", "items": { "$ref": "#/$defs/catalogItem" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "search" } } },
      "then": { "properties": { "data": { "type": "object", "required": ["items", "query"] } } }
    },
    {
      "if": { "properties": { "command": { "const": "info" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["item"],
            "properties": { "item": { "$ref": "#/$defs/catalogItem" } },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "add" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["dryRun", "item", "files"],
            "properties": {
              "dryRun": { "type": "boolean" },
              "item": { "$ref": "#/$defs/addItem" },
              "files": { "type": "array", "items": { "$ref": "#/$defs/addFile" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "installed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/installedItem" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "status" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["items", "counts"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/statusItem" },
                    { "$ref": "#/$defs/unmanagedItem" }
                  ]
                }
              },
              "counts": { "$ref": "#/$defs/counts" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "enum": ["update", "remove", "restore"] }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["dryRun", "items"],
            "properties": {
              "dryRun": { "type": "boolean" },
              "items": { "type": "array", "items": { "$ref": "#/$defs/mutationItem" } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "doctorCheck": {
      "type": "object",
      "required": ["code", "state", "message", "action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "state": { "enum": ["ok", "warn", "fail", "skip"] },
        "message": { "type": "string" },
        "action": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "catalogItem": {
      "type": "object",
      "required": ["provider", "id", "name", "description"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "manifestSha256": { "$ref": "#/$defs/digest" },
        "kind": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "license": { "type": ["object", "null"] },
        "files": { "type": "array", "items": { "type": "object" } },
        "dependencies": { "type": "array", "items": { "type": "object" } },
        "packages": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": { "type": ["string", "null"] },
    "owner": {
      "type": "object",
      "required": ["providerId", "itemId"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "addItem": {
      "type": "object",
      "required": ["providerId", "itemId", "version", "manifestSha256"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "manifestSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "addFile": {
      "type": "object",
      "required": ["target", "action", "ownerBefore", "ownerAfter"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "action": { "enum": ["install", "unchanged"] },
        "ownerBefore": { "oneOf": [{ "$ref": "#/$defs/owner" }, { "type": "null" }] },
        "ownerAfter": { "$ref": "#/$defs/owner" }
      },
      "additionalProperties": false
    },
    "mutationItem": {
      "type": "object",
      "required": ["providerId", "itemId", "actions"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/mutationAction" } }
      },
      "additionalProperties": false
    },
    "mutationAction": {
      "type": "object",
      "required": ["target", "action", "ownerBefore", "ownerAfter"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "action": { "enum": ["install", "replace", "unchanged", "remove", "already-missing", "restore"] },
        "ownerBefore": { "oneOf": [{ "$ref": "#/$defs/owner" }, { "type": "null" }] },
        "ownerAfter": { "oneOf": [{ "$ref": "#/$defs/owner" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "installedItem": {
      "type": "object",
      "required": ["providerId", "itemId", "version", "manifestSha256", "fileCount"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "manifestSha256": { "$ref": "#/$defs/digest" },
        "fileCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "statusItem": {
      "type": "object",
      "required": ["providerId", "itemId", "version", "manifestSha256", "files"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "manifestSha256": { "$ref": "#/$defs/digest" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileStatus" } }
      },
      "additionalProperties": false
    },
    "unmanagedItem": {
      "type": "object",
      "required": ["selector", "state", "files"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "state": { "const": "unmanaged" },
        "files": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "fileStatus": {
      "type": "object",
      "required": ["target", "state", "expectedSha256", "actualSha256"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "state": { "enum": ["unchanged", "modified", "missing", "unsafe", "unreadable"] },
        "expectedSha256": { "$ref": "#/$defs/digest" },
        "actualSha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "unchanged": { "type": "integer", "minimum": 0 },
        "modified": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "unsafe": { "type": "integer", "minimum": 0 },
        "unreadable": { "type": "integer", "minimum": 0 },
        "unmanaged": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
