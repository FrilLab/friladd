{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrilAdd Configuration v1",
  "description": "FrilAdd also enforces the file byte limit, rejects duplicate property names, and checks that a non-null default refers to an alias in the same configuration. FrilAdd checks that required text contains a non-whitespace character.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "defaultRegistry": {
      "anyOf": [
        {
          "$ref": "#/$defs/alias"
        },
        {
          "type": "null"
        }
      ]
    },
    "registries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/alias"
      },
      "additionalProperties": {
        "$ref": "#/$defs/registry"
      }
    }
  },
  "$defs": {
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "registry": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
