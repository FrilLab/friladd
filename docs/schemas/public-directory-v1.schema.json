{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friladd.dev/schemas/public-directory-v1.schema.json",
  "title": "FrilAdd public registry directory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registries": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/registry" }
    }
  },
  "$defs": {
    "cleanString": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "registryUrl", "repository", "publisher", "tier", "status", "reviewedRevision", "manifestSha256", "review"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "displayName": { "allOf": [{ "$ref": "#/$defs/cleanString" }, { "maxLength": 128, "minLength": 1 }] },
        "description": { "allOf": [{ "$ref": "#/$defs/cleanString" }, { "maxLength": 512, "minLength": 1 }] },
        "registryUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "allOf": [{ "$ref": "#/$defs/cleanString" }, { "maxLength": 128, "minLength": 1 }] },
        "tier": { "enum": ["official", "community"] },
        "status": { "enum": ["active", "deprecated", "suspended"] },
        "reviewedRevision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewedAt", "reviewer", "notes"],
          "properties": {
            "reviewedAt": { "type": "string", "format": "date-time" },
            "reviewer": { "allOf": [{ "$ref": "#/$defs/cleanString" }, { "maxLength": 128, "minLength": 1 }] },
            "notes": { "allOf": [{ "$ref": "#/$defs/cleanString" }, { "maxLength": 1024, "minLength": 1 }] }
          }
        }
      }
    }
  }
}
